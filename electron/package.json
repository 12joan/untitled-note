{
  "name": "note-electron",
  "type": "module",
  "version": "0.4.1",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "build": "cd .. && yarn build-electron",
    "start": "ELECTRON_ENABLE_LOGGING=1 electron-forge start -- --env development",
    "start-staging": "ELECTRON_ENABLE_LOGGING=1 electron-forge start -- --env staging",
    "package": "electron-forge package --arch universal --platform=darwin",
    "make": "electron-forge make --arch universal --platform=darwin",
    "publish-app": "electron-forge publish --arch=universal --platform=darwin"
  },
  "dependencies": {
    "electron": "^43.8.1",
    "electron-context-menu": "^4.1.2",
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.0",
    "@electron-forge/maker-deb": "^8.0.0",
    "@electron-forge/maker-rpm": "^8.0.0",
    "@electron-forge/maker-squirrel": "^8.0.0",
    "@electron-forge/maker-zip": "^8.0.0",
    "@electron-forge/publisher-github": "^8.0.0",
    "electron": "^43.8.1"
  },
  "resolutions": {
    "@electron/asar": "^4.2.1",
    "tar": "^7.5.22"
  }
}
